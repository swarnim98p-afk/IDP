:root{font-family:Inter,system-ui,sans-serif;color:#17213b;background:#f4f5fb;font-synthesis:none}body{margin:0;min-height:100vh;display:grid;place-items:center}main{max-width:640px;background:white;padding:48px;border-radius:24px;box-shadow:0 20px 60px #17213b12;margin:24px}h1{font-size:clamp(32px,5vw,52px);letter-spacing:-.04em;overflow-wrap:anywhere}.eyebrow{font-size:12px;letter-spacing:.16em;color:#7259d9;font-weight:700}p{line-height:1.7}button{background:#7259d9;color:white;border:0;border-radius:10px;padding:14px 20px;font:inherit;cursor:pointer}
