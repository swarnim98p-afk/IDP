import React from 'react';
import { createRoot } from 'react-dom/client';
import './style.css';

const projectName = {{.ProjectNameJSON}};
function App() {
  const [count, setCount] = React.useState(0);
  return <main><p className="eyebrow">CREATED WITH LAUNCHPAD</p><h1>{projectName}</h1><p>Your React application is ready. Edit src/main.jsx to make it your own.</p><button onClick={() => setCount(count + 1)}>Clicked {count} times</button></main>;
}
createRoot(document.getElementById('root')).render(<App />);
